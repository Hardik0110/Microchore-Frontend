# Vite reads VITE_-prefixed env vars and exposes them via import.meta.env.
# Copy this file to .env.local for local development, or paste these into the
# Vercel Project Settings -> Environment Variables panel for deployed builds.

# Backend API base URL (no trailing slash).
# Local dev:                  http://127.0.0.1:8000
# Cloudflare quick tunnel:    https://xxxx-xxxx.trycloudflare.com  (rotates per restart)
# Named tunnel on your domain: https://api.yourdomain.com
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth Web Client ID (must list the deploy origin in Authorized JavaScript Origins).
VITE_GOOGLE_CLIENT_ID=
